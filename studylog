import sys


def main():
    mode = "total"
    if len(sys.argv) == 2:
        if sys.argv[1] == "-p":
            mode = "pomodoro"
        elif sys.argv[1] == "-s":
            mode = "subject"
        else:
            print("Error: unknown option", file=sys.stderr)
            sys.exit(1)
    elif len(sys.argv) > 2:
        print("Error: too many arguments", file=sys.stderr)
        sys.exit(1)

    total_minutes = 0
    subject_minutes = {}
    has_data = False

    for line in sys.stdin:
        line = line.strip()
        if not line:
            continue

        parts = line.split(maxsplit=1)
        try:
            minutes = int(parts[0])
        except ValueError:
            print("Error: minutes must be an integer", file=sys.stderr)
            sys.exit(1)

        if minutes < 0:
            print("Error: minutes must be non-negative", file=sys.stderr)
            sys.exit(1)

        has_data = True
        total_minutes += minutes
        subject = parts[1] if len(parts) == 2 else "other"
        subject_minutes[subject] = subject_minutes.get(subject, 0) + minutes

    if not has_data:
        print("Error: no input data", file=sys.stderr)
        sys.exit(1)

    if mode == "total":
        print(total_minutes)
    elif mode == "pomodoro":
        print(total_minutes // 25)
    elif mode == "subject":
        for subject, mins in subject_minutes.items():
            print(f"{subject} {mins}")


if __name__ == "__main__":
    main()
