import random
import sys


def main():
    color = False
    snow = False

    for arg in sys.argv[1:]:
        if arg == "-c":
            color = True
        elif arg == "-s":
            snow = True
        elif arg in ("-cs", "-sc"):
            color = True
            snow = True
        else:
            sys.stderr.write("Usage: xtree [-c] [-s]\n")
            sys.exit(1)

    text = sys.stdin.read().strip()
    if not text:
        sys.stderr.write("Error: empty input\n")
        sys.exit(1)

    rng = random.Random(2026)
    height = 10
    width = height * 2 + 7
    mid = width // 2

    lines = []

    star = [" "] * width
    star[mid] = "★"
    lines.append(star)

    for i in range(height):
        row = [" "] * width
        for j in range(-i - 1, i + 2):
            pos = mid + j
            if j == -i - 1:
                row[pos] = "/"
            elif j == i + 1:
                row[pos] = "\\"
            elif rng.random() < 0.3:
                row[pos] = rng.choice(["*", "o", "+"])
            else:
                row[pos] = "^"
        lines.append(row)

    for _ in range(2):
        row = [" "] * width
        row[mid - 1] = "|"
        row[mid] = "#"
        row[mid + 1] = "|"
        lines.append(row)

    if snow:
        for r in range(len(lines)):
            for c in range(width):
                if lines[r][c] == " " and rng.random() < 0.12:
                    lines[r][c] = "."

    for row in lines:
        out_line = ""
        for ch in row:
            if not color or ch == " ":
                out_line += ch
            elif ch == "★":
                out_line += f"\033[93m{ch}\033[0m"
            elif ch in ("*", "o", "+"):
                c = rng.choice(["\033[91m", "\033[93m", "\033[96m"])
                out_line += f"{c}{ch}\033[0m"
            elif ch == ".":
                out_line += f"\033[97m{ch}\033[0m"
            elif ch in ("|", "#"):
                out_line += f"\033[33m{ch}\033[0m"
            else:
                out_line += f"\033[92m{ch}\033[0m"
        print(out_line.rstrip())

    msg = " ".join(text.split())
    pad = max(0, (width - len(msg) - 4) // 2)
    bar = " " * pad + "+" + "-" * (len(msg) + 2) + "+"
    body = " " * pad + "| " + msg + " |"
    if color:
        print(f"\n\033[93m{bar}\033[0m")
        print(f"\033[96m{body}\033[0m")
        print(f"\033[93m{bar}\033[0m")
    else:
        print(f"\n{bar}\n{body}\n{bar}")


if __name__ == "__main__":
    main()
