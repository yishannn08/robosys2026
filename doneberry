import sys
from deep_translator import MyMemoryTranslator


def is_japanese(text):
    for ch in text:
        if "\u3040" <= ch <= "\u30ff" or "\u4e00" <= ch <= "\u9fff":
            return True
    return False


def has_letter(text):
    for ch in text:
        if ch.isalpha():
            return True
    return False


if len(sys.argv) != 1:
    sys.stderr.write("Usage: doneberry < text\n")
    sys.exit(1)

ja_to_ms = MyMemoryTranslator(source="ja", target="ms-MY")
ms_to_ja = MyMemoryTranslator(source="ms", target="ja-JP")

has_data = False

for line in sys.stdin:
    text = line.strip()
    if not text:
        continue
    has_data = True

    if not has_letter(text):
        sys.stderr.write("Invalid input\n")
        sys.exit(1)

    try:
        if is_japanese(text):
            ans = ja_to_ms.translate(text)
        else:
            ans = ms_to_ja.translate(text)
        print(f"{text} -> {ans}")
    except Exception:
        sys.stderr.write("Translation error\n")
        sys.exit(1)

if not has_data:
    sys.stderr.write("No input\n")
    sys.exit(1)

