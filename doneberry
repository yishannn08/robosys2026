import json
import sys
import urlib.parse
import urlib.request


def is_japanese(text):
    for ch in text:
        if "\u3040" <= ch <= "\u30ff" or "\u4e00" <= ch <= "\u9fff":
            return True
    return False


def has_letter(text):
    for ch in text:
        if ch.isalpha():
            return True
    return False

def translate(text, src, dst):
    q = urllib.parse.quote(text)
    url = f"https://translate.googleapis.com/translate_a/single?client=gtx&sl={src}&tl={dst}&dt=t&q={q}"
    req = urllib.request.Request(url, headers={"User-Agent": "Mozilla/5.0"})
    with urllib.request.urlopen(req, timeout=5) as res:
        data = json.loads(res.read().decode("utf-8"))
        return "".join(part[0] for part in data[0] if part[0])

if len(sys.argv) != 1:
    sys.stderr.write("Usage: doneberry < text\n")
    sys.exit(1)

has_data = False

for line in sys.stdin:
    text = line.strip()
    if not text:
        continue
    has_data = True

    if not has_letter(text):
        sys.stderr.write("Invalid input\n")
        sys.exit(1)

    try:
        if is_japanese(text):
            ans = ja_to_ms.translate(text, "ja", "ms")
        else:
            ans = ms_to_ja.translate(text,"ms", "ja")
        print(f"{text} -> {ans}")
    except Exception:
        sys.stderr.write("Translation error\n")
        sys.exit(1)

if not has_data:
    sys.stderr.write("No input\n")
    sys.exit(1)

