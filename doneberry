import csv
from datetime import date
import sys


def main():
    if len(sys.argv) > 1:
        sys.stderr.write("Usage: taskchk < tasks.csv\n")
        sys.exit(1)

    reader = csv.DictReader(sys.stdin)
    required = {"task", "status", "due"}
    if not reader.fieldnames or not required.issubset(set(reader.fieldnames)):
        sys.stderr.write("Error: CSV header must include task,status,due\n")
        sys.exit(1)

    rows = list(reader)
    if not rows:
        sys.stderr.write("Error: no task rows found\n")
        sys.exit(1)

    today = date.today()
    total = 0
    done = 0
    seen = set()
    duplicates = []
    missing_due = []
    overdue = []

    for row in rows:
        if None in row.values():
            sys.stderr.write("Error: malformed CSV row\n")
            sys.exit(1)

        name = row["task"].strip()
        status = row["status"].strip().lower()
        due = row["due"].strip()

        if not name:
            sys.stderr.write("Error: empty task name\n")
            sys.exit(1)

        total += 1
        if status == "done":
            done += 1

        key = name.lower()
        if key in seen:
            duplicates.append(name)
        seen.add(key)

        if not due:
            missing_due.append(name)
        else:
            try:
                due_date = date.fromisoformat(due)
            except ValueError:
                sys.stderr.write(f"Error: invalid date '{due}'\n")
                sys.exit(1)

            if due_date < today and status != "done":
                overdue.append(name)

    print("TASK REPORT")
    print("-----------")
    print(f"Total     : {total}")
    print(f"Completed : {done}")
    print(f"Remaining : {total - done}")
    print(f"Duplicates: {len(duplicates)}")
    print(f"No due    : {len(missing_due)}")
    print(f"Overdue   : {len(overdue)}")

    if overdue:
        print("\nOverdue list:")
        for item in overdue:
            print(f"- {item}")


if __name__ == "__main__":
    main()
